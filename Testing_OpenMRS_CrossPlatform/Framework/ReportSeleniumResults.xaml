<Activity mc:Ignorable="sap sap2010" x:Class="Framework_ReportSeleniumResults" mva:VisualBasic.Settings="{x:Null}" sap2010:WorkflowViewState.IdRef="ActivityBuilder_1" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:uta="clr-namespace:UiPath.Testing.Activities;assembly=UiPath.Testing.Activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_ScenarioLabel" Type="InArgument(x:String)" />
    <x:Property Name="in_dt_TestResults" Type="InArgument(sd:DataTable)" />
    <x:Property Name="in_ResultsFolder" Type="InArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>UiPath.Testing.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Testing.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Report Selenium results" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <ui:LogMessage DisplayName="Log result count" Level="Info" Message="[&quot;Reporting &quot; &amp; in_dt_TestResults.Rows.Count.ToString &amp; &quot; Selenium test(s) for &quot; &amp; in_ScenarioLabel]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[in_dt_TestResults]" DisplayName="For each Selenium test" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="CurrentRow" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Report one Selenium checkpoint" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <If Condition="[CurrentRow(&quot;Outcome&quot;).ToString &lt;&gt; &quot;passed&quot;]" DisplayName="If the checkpoint did not pass" sap2010:WorkflowViewState.IdRef="If_1">
              <If.Then>
                <ui:LogMessage DisplayName="Log the Selenium failure message" Level="Warn" Message="[CurrentRow(&quot;Name&quot;).ToString &amp; &quot; (&quot; &amp; CurrentRow(&quot;Outcome&quot;).ToString &amp; &quot;): &quot; &amp; CurrentRow(&quot;Message&quot;).ToString]" sap2010:WorkflowViewState.IdRef="LogMessage_2" />
              </If.Then>
            </If>
            <If Condition="[CurrentRow(&quot;Outcome&quot;).ToString &lt;&gt; &quot;not reached&quot;]" DisplayName="If the checkpoint ran (steps after a failure are named in the failure's message instead)" sap2010:WorkflowViewState.IdRef="If_2">
              <If.Then>
            <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Verify the checkpoint with its Selenium screenshot" UnSafe="False" WorkflowFileName="Framework\VerifyWithEvidence.cs" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1">
              <ui:InvokeWorkflowFile.Arguments>
                <scg:Dictionary x:TypeArguments="x:String, Argument">
                  <InArgument x:TypeArguments="x:String" x:Key="in_Title">[in_ScenarioLabel &amp; " | " &amp; CurrentRow("Test").ToString &amp; " | " &amp; CurrentRow("Step").ToString &amp; ". " &amp; CurrentRow("Name").ToString]</InArgument>
                  <InArgument x:TypeArguments="x:Boolean" x:Key="in_Passed">[CurrentRow("Outcome").ToString = "passed"]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="in_Message">[If(CurrentRow("Outcome").ToString = "passed", "", CurrentRow("Outcome").ToString.ToUpper &amp; ": " &amp; CurrentRow("Message").ToString)]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="in_ScreenshotPath">[CurrentRow("Screenshot").ToString]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="in_Details">["Selenium test: " &amp; CurrentRow("Test").ToString &amp; vbLf &amp; "Outcome: " &amp; CurrentRow("Outcome").ToString &amp; If(CurrentRow("Message").ToString = "", "", vbLf &amp; vbLf &amp; CurrentRow("Message").ToString)]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="in_DetailsFile">[""]</InArgument>
                </scg:Dictionary>
              </ui:InvokeWorkflowFile.Arguments>
            </ui:InvokeWorkflowFile>
              </If.Then>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
    <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="For each evidence file (report, logs, data; screenshots live on the assertions)" Values="[New String() {&quot;SeleniumReport.html&quot;, &quot;execution-trail.log&quot;, &quot;browser-console.log&quot;, &quot;webdriver.log&quot;, &quot;console.log&quot;, &quot;checkpoints.json&quot;, &quot;junit.xml&quot;, &quot;output.json&quot;}.Select(Function(f) Path.Combine(in_ResultsFolder, f)).Where(Function(f) File.Exists(f))]" sap2010:WorkflowViewState.IdRef="ForEach`1_1">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:String">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:String" Name="evidenceFile" />
          </ActivityAction.Argument>
          <uta:AttachDocument ContinueOnError="True" DisplayName="Attach evidence to the test result" FilePath="[evidenceFile]" Tags="[New String() {in_ScenarioLabel, &quot;Selenium&quot;}]" sap2010:WorkflowViewState.IdRef="AttachDocument_1" />
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
  </Sequence>
</Activity>
