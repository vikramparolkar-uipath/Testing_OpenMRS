  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Report Selenium results" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <ui:LogMessage DisplayName="Log result count" Level="Info" Message="[&quot;Reporting &quot; &amp; in_dt_TestResults.Rows.Count.ToString &amp; &quot; Selenium test(s) for &quot; &amp; in_ScenarioLabel]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[in_dt_TestResults]" DisplayName="For each Selenium test" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="CurrentRow" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Report one Selenium test" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <If Condition="[CurrentRow(&quot;Outcome&quot;).ToString &lt;&gt; &quot;passed&quot;]" DisplayName="If the Selenium test did not pass" sap2010:WorkflowViewState.IdRef="If_1">
              <If.Then>
                <ui:LogMessage DisplayName="Log the Selenium failure message" Level="Warn" Message="[CurrentRow(&quot;Name&quot;).ToString &amp; &quot; (&quot; &amp; CurrentRow(&quot;Outcome&quot;).ToString &amp; &quot;): &quot; &amp; CurrentRow(&quot;Message&quot;).ToString]" sap2010:WorkflowViewState.IdRef="LogMessage_2" />
              </If.Then>
            </If>
            <uta:VerifyExpression AlternativeVerificationTitle="[in_ScenarioLabel &amp; &quot; | &quot; &amp; CurrentRow(&quot;Name&quot;).ToString]" DisplayName="Verify the Selenium test passed" Expression="[CurrentRow(&quot;Outcome&quot;).ToString = &quot;passed&quot;]" KeepScreenshots="{x:Null}" OutputMessageFormat="{x:Null}" Result="{x:Null}" ScreenshotsPath="{x:Null}" ContinueOnFailure="True" TakeScreenshotInCaseOfFailingAssertion="False" TakeScreenshotInCaseOfSucceedingAssertion="False" sap2010:WorkflowViewState.IdRef="VerifyExpression_1" />
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
    <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="For each evidence file" Values="[New String() {&quot;junit.xml&quot;, &quot;console.log&quot;, &quot;output.json&quot;}.Select(Function(f) Path.Combine(in_ResultsFolder, f)).Where(Function(f) File.Exists(f)).Concat(If(Directory.Exists(Path.Combine(in_ResultsFolder, &quot;screenshots&quot;)), Directory.GetFiles(Path.Combine(in_ResultsFolder, &quot;screenshots&quot;), &quot;*.png&quot;), New String() {}))]" sap2010:WorkflowViewState.IdRef="ForEach`1_1">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:String">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:String" Name="evidenceFile" />
          </ActivityAction.Argument>
          <uta:AttachDocument ContinueOnError="True" DisplayName="Attach evidence to the test result" FilePath="[evidenceFile]" Tags="[New String() {in_ScenarioLabel, &quot;Selenium&quot;}]" sap2010:WorkflowViewState.IdRef="AttachDocument_1" />
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
  </Sequence>
</Activity>
